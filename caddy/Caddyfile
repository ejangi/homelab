# Common routing for the Tailscale hostname and the local diagnostic listener.
# Immich must occupy a host root; it does not support a sub-path such as
# /photos. The specific /n8n, /matrix, and /files routes continue to take
# precedence over the Immich fallback.
(service_routes) {
    log

    # 1. N8N Proxy Block: Match requests starting with /n8n/
    handle /n8n* {
        # CRITICAL: Strip the /n8n prefix from the URI before forwarding
        uri strip_prefix /n8n

        reverse_proxy n8n:5678 {
            header_up Upgrade {header.Upgrade}
            header_up Connection {header.Connection}
            header_up Host {host}
        }
    }

    # Matrix Service setup UI and authenticated API. The matrix container is
    # not published directly; this route is reachable only through Caddy.
    handle_path /matrix/* {
        reverse_proxy matrix:8787
    }

    # SFTPGo's WebAdmin and WebClient are configured with /files as their web
    # root. The REST API is intentionally retained at its native /api/v2 path.
    handle /files {
        # `*` prevents Caddy treating the destination as a path matcher.
        redir * /files/web/client 302
    }

    handle /files/* {
        reverse_proxy sftpgo:8080
    }

    handle /api/v2/* {
        reverse_proxy sftpgo:8080
    }

    # Immich is available only to Tailscale peers. Keep this as the final
    # fallback because `handle` blocks are mutually exclusive.
    @tailscale remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
    handle @tailscale {
        reverse_proxy immich_server:2283
    }

    handle {
        respond "Tailscale access required" 403
    }
}

# This is the user-facing endpoint. The certificate is issued and renewed by
# `tailscale cert`, so browsers and mobile apps trust it normally.
ejangi-nix.bobtail-morpho.ts.net {
    tls /etc/caddy/tailscale-certs/cert.pem /etc/caddy/tailscale-certs/key.pem
    import service_routes
}

# Preserve the existing local Caddy endpoint without exposing its internal CA
# certificate to remote clients.
localhost:8080 {
    tls internal
    import service_routes
}
