[Unit]
Description=Renew the Tailscale TLS certificate used by Caddy

[Service]
Type=oneshot
WorkingDirectory=/home/ejangi/Sites/n8n
ExecStart=/usr/bin/tailscale cert --min-validity=720h --cert-file ./caddy/tailscale-certs/cert.pem --key-file ./caddy/tailscale-certs/key.pem ejangi-nix.bobtail-morpho.ts.net
ExecStartPost=/usr/bin/docker exec n8n_caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
