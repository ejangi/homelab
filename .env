# ==============================================================================
# .env File for Docker Compose Configuration
# ==============================================================================

# --- 1. Database Configuration (Shared by n8n and postgres) ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n
# !! CRITICAL: Update this with a strong, secret password !!
POSTGRES_PASSWORD=insertpasswordhere
# Note: DB_TYPE, HOST, PORT are hardcoded in compose as they are static.
# DB_POSTGRES_HOST=postgres
# DB_POSTGRES_PORT=5432

# --- 2. n8n Security and Host Settings ---
# !! CRITICAL: Update the HOST and WEBHOOK_URL for your domain !!
N8N_HOST=something.something.ts.net
WEBHOOK_URL=https://${N8N_HOST}/

# !! CRITICAL: Update these with strong, secret credentials !!
N8N_BASIC_AUTH_USER=ejangi
N8N_BASIC_AUTH_PASSWORD=insertpasswordhere
N8N_ENCRYPTION_KEY=insertpasswordhere

# Static/Non-Secret Settings
N8N_PROTOCOL=https
GENERIC_TIMEZONE=Australia/Brisbane
TZ=Australia/Brisbane
N8N_LISTEN_ADDRESS=0.0.0.0
N8N_PATH=/n8n/
N8N_SECURE_COOKIE=true
N8N_BASIC_AUTH_ACTIVE=true

# --- 3. Networking Configuration ---
# You generally don't need to change these unless you have network conflicts
NETWORK_SUBNET=192.168.0.0/16
SFTPGO_ADMIN_PASSWORD=insertpasswordhere
SMB_PASSWORD=insertpasswordhere

# Matrix notification service
MATRIX_HOMESERVER_URL=https://matrix.org
MATRIX_USER_ID=@userid:matrix.org
MATRIX_PASSWORD=insertpasswordhere
MATRIX_DEFAULT_ROOM_ID=!roomid:matrix.org
MATRIX_SERVICE_API_KEY=insertpasswordhere
MATRIX_STORE_ENCRYPTION_KEY=insertpasswordhere
MATRIX_IDEMPOTENCY_RETENTION_DAYS=30
MATRIX_SERVICE_URL=http://matrix:8787
#
# Immich — kept distinct from the n8n PostgreSQL configuration above.
#
IMMICH_UPLOAD_LOCATION=/mnt/Photos/immich/data
IMMICH_DB_DATA_LOCATION=/mnt/Photos/immich/postgres
IMMICH_MODEL_CACHE_LOCATION=/mnt/Photos/immich/model-cache
IMMICH_EXTERNAL_LIBRARY_LOCATION=/mnt/Photos/library
IMMICH_VERSION=v3.1.0
IMMICH_DB_PASSWORD=insertpasswordhere
IMMICH_DB_USERNAME=postgres
IMMICH_DB_DATABASE_NAME=immich
IMMICH_DB_HOSTNAME=immich_database
IMMICH_REDIS_HOSTNAME=immich_redis
