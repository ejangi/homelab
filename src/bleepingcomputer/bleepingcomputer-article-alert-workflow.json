    {
      "parameters": {
        "jsCode": "function decodeEntities(value) {\n  const named = { amp: '&', apos: \"'\", gt: '>', lt: '<', nbsp: ' ', quot: '\"' };\n  return value.replace(/&(#x[0-9a-f]+|#\\d+|[a-z]+);/gi, (entity, reference) => {\n    const lower = reference.toLowerCase();\n    if (lower[0] !== '#') return named[lower] ?? entity;\n    const codePoint = lower.startsWith('#x') ? Number.parseInt(lower.slice(2), 16) : Number.parseInt(lower.slice(1), 10);\n    try { return String.fromCodePoint(codePoint); } catch { return entity; }\n  });\n}\n\nfunction toPlainText(value) {\n  return decodeEntities(value.replace(/<script[\\s\\S]*?<\\/script>|<style[\\s\\S]*?<\\/style>/gi, '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim());\n}\n\nfunction escapeMarkdown(value) { return value.replace(/([\\\\`*_{}[\\]<>])/g, '\\\\$1'); }\n\nfunction compact(value, maxLength) { return value.length <= maxLength ? value : `${value.slice(0, maxLength - 1).trimEnd()}…`; }\n\nfunction requestIdFor(value) {\n  let hash = 5381;\n  for (const character of value) hash = ((hash << 5) + hash) ^ character.charCodeAt(0);\n  return `bleepingcomputer-${(hash >>> 0).toString(36)}`;\n}\n\nfunction linkTarget(url) { return url.replace(/\\s/g, '%20').replace(/\\(/g, '%28').replace(/\\)/g, '%29'); }\n\nconst articles = $input.all().flatMap((item) => {\n  const article = item.json;\n  const articleUrl = String(article.link ?? '').trim();\n  const articleId = String(article.guid ?? articleUrl).trim();\n  const title = toPlainText(String(article.title ?? ''));\n  if (!articleId || !title) return [];\n\n  if (!/^https:\\/\\/www\\.bleepingcomputer\\.com\\//.test(articleUrl)) return [];\n\n  // BleepingComputer ends every teaser with a trailing \"[...]\" marker.\n  const description = compact(toPlainText(String(article.contentSnippet ?? article.content ?? article.description ?? '')).replace(/\\s*\\[(?:\\.{3}|…)\\]$/, ''), 700);\n  const categories = [...new Set((Array.isArray(article.categories) ? article.categories : []).map((category) => toPlainText(String(category))).filter(Boolean))];\n\n  const published = new Date(article.isoDate ?? article.pubDate ?? '');\n  const publishedAt = Number.isNaN(published.valueOf()) ? null : published.toISOString();\n\n  return [{\n    json: {\n      article_id: articleId,\n      title,\n      categories: categories.join(', '),\n      description,\n      article_url: articleUrl,\n      published_at: publishedAt,\n      first_seen_at: new Date().toISOString(),\n      message: [\n        `📰 **[${escapeMarkdown(title)}](${linkTarget(articleUrl)})**`,\n        categories.length ? `🏷️ ${categories.map(escapeMarkdown).join(' · ')}` : null,\n        description ? escapeMarkdown(description) : null,\n      ].filter((line) => line !== null).join('\\n\\n'),\n      matrix_request_id: requestIdFor(articleId),\n    },\n  }];\n});\n\n// Deliver oldest first so Matrix shows articles in publication order.\nreturn articles.sort((a, b) => String(a.json.published_at ?? '').localeCompare(String(b.json.published_at ?? '')));"
      },
