    {
      "parameters": {
        "jsCode": "function decodeEntities(value) {\n  const named = { amp: '&', apos: \"'\", gt: '>', lt: '<', nbsp: ' ', quot: '\"' };\n  return value.replace(/&(#x[0-9a-f]+|#\\d+|[a-z]+);/gi, (entity, reference) => {\n    const lower = reference.toLowerCase();\n    if (lower[0] !== '#') return named[lower] ?? entity;\n    const codePoint = lower.startsWith('#x') ? Number.parseInt(lower.slice(2), 16) : Number.parseInt(lower.slice(1), 10);\n    try { return String.fromCodePoint(codePoint); } catch { return entity; }\n  });\n}\n\nfunction toPlainText(value) {\n  return decodeEntities(value.replace(/<script[\\s\\S]*?<\\/script>|<style[\\s\\S]*?<\\/style>/gi, '').replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim());\n}\n\nfunction escapeMarkdown(value) {\n  return value.replace(/([\\\\`*_{}[\\]<>])/g, '\\\\$1');\n}\n\nfunction compact(value, maxLength) {\n  return value.length <= maxLength ? value : `${value.slice(0, maxLength - 1).trimEnd()}…`;\n}\n\nfunction requestIdFor(value) {\n  let hash = 5381;\n  for (const character of value) hash = ((hash << 5) + hash) ^ character.charCodeAt(0);\n  return `immich-release-${(hash >>> 0).toString(36)}`;\n}\n\nconst feed = $input.first().json;\nconst posts = Array.isArray(feed.items) ? feed.items : [];\n\nreturn posts.flatMap((post) => {\n  const title = String(post.title ?? '').trim();\n  // The feed also contains recaps and migration guides. Only release posts are alerts.\n  if (!/^release\\s+v/i.test(title)) return [];\n\n  const releaseId = String(post.id ?? post.url ?? '').trim();\n  const releaseUrl = String(post.url ?? post.external_url ?? '').trim();\n  const description = compact(toPlainText(String(post.content_text ?? post.summary ?? post.content_html ?? '')), 1000);\n  const publishedAt = String(post.date_published ?? post.date_modified ?? '').trim() || null;\n\n  if (!releaseId || !releaseUrl || !description) return [];\n\n  return [{\n    json: {\n      release_id: releaseId,\n      title,\n      release_url: releaseUrl,\n      release_notes: description,\n      published_at: publishedAt,\n      first_seen_at: new Date().toISOString(),\n      message: [\n        '📷 **New Immich release**',\n        '',\n        `**${escapeMarkdown(title)}**`,\n        '',\n        escapeMarkdown(description),\n        '',\n        `[Read the full article](${releaseUrl})`,\n      ].join('\\n'),\n      matrix_request_id: requestIdFor(releaseId),\n    },\n  }];\n});"
      },
