      "name": "Fetch Goodreads science-fiction books",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000,
      "position": [-680, 0]
