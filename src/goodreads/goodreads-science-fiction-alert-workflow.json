    {
      "parameters": {
        "jsCode": "function escapeMarkdown(value) { return value.replace(/([\\\\`*_{}[\\]<>])/g, '\\\\$1'); }\n\nfunction requestIdFor(value) {\n  let hash = 5381;\n  for (const character of value) hash = ((hash << 5) + hash) ^ character.charCodeAt(0);\n  return `goodreads-science-fiction-${(hash >>> 0).toString(36)}`;\n}\n\nfunction bookIdFromUrl(bookUrl) {\n  return String(bookUrl).match(/^https:\\/\\/(?:www\\.)?goodreads\\.com\\/book\\/show\\/(\\d+)(?:[-/?#]|$)/i)?.[1] ?? '';\n}\n\nfunction allowedCoverUrl(value) {\n  return /^https:\\/\\/i\\.gr-assets\\.com(?:\\/|$)/i.test(value) ? value : '';\n}\n\nfunction normalizeDescription(value) {\n  return String(value ?? '')\n    .replace(/\\\\r\\\\n/g, '\\n')\n    .replace(/\\\\n/g, '\\n')\n    .replace(/\\\\t/g, ' ')\n    .replace(/\\\\([\"'\\\\])/g, '$1')\n    .replace(/\\r\\n?/g, '\\n')\n    .trim();\n}\n\nreturn $input.all().map((item) => {\n  const book = item.json;\n  const title = String(book.title ?? '').trim();\n  const bookUrl = String(book.url ?? '').trim();\n  const bookId = bookIdFromUrl(bookUrl);\n  const ratingAvg = Number(book.rating_avg);\n  const ratingCount = Number(book.rating_count);\n  const description = normalizeDescription(book.description) || 'No description supplied.';\n  const imageUrl = allowedCoverUrl(String(book.image_url ?? '').trim());\n  const genre = String(book.genre ?? 'science-fiction').trim();\n\n  if (!bookId || !title || !Number.isFinite(ratingAvg) || !Number.isFinite(ratingCount) || !imageUrl) {\n    throw new Error(`Goodreads API returned an incomplete book listing: ${bookId || title || 'unknown book'}`);\n  }\n\n  return {\n    json: {\n      book_id: bookId,\n      title,\n      rating_avg: ratingAvg,\n      rating_count: ratingCount,\n      description,\n      book_url: bookUrl,\n      image_url: imageUrl,\n      genre,\n      first_seen_at: new Date().toISOString(),\n      message: [\n        '📚 **New Goodreads science-fiction listing**',\n        '',\n        `**${escapeMarkdown(title)}**`,\n        `**Average rating:** ${ratingAvg.toFixed(2)} / 5`,\n        `**Ratings:** ${ratingCount.toLocaleString('en-AU')}`,\n        '',\n        escapeMarkdown(description),\n        '',\n        `[View this book on Goodreads](${bookUrl})`,\n      ].join('\\n'),\n      image_alt: `${title} cover`,\n      matrix_request_id: requestIdFor(bookId),\n    },\n  };\n});"
      },
