      "name": "Fetch Up RSS feed",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [
        -680,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "function requestIdFor(value) {\n  let hash = 5381;\n  for (const character of value) {\n    hash = ((hash << 5) + hash) ^ character.charCodeAt(0);\n  }\n  return `up-blog-${(hash >>> 0).toString(36)}`;\n}\n\nfunction formatInBrisbane(date) {\n  return new Intl.DateTimeFormat('en-AU', {\n    timeZone: 'Australia/Brisbane',\n    day: '2-digit',\n    month: 'short',\n    year: 'numeric',\n  }).format(date);\n}\n\nfunction escapeMarkdown(value) {\n  return value.replace(/([\\\\`*_{}[\\]<>])/g, '\\\\$1');\n}\n\nreturn $input.all().flatMap((item) => {\n  const post = item.json;\n  const postUrl = typeof post.link === 'string' ? post.link.trim() : '';\n  const postId = String(post.guid ?? postUrl).trim();\n  const title = String(post.title ?? '').trim();\n  // rss-parser exposes RSS <description> as content/contentSnippet.\n  const summary = String(post.content ?? post.contentSnippet ?? post.description ?? '').trim();\n\n  if (!postId || !postUrl || !title || !summary) {\n    return [];\n  }\n\n  const published = new Date(post.isoDate ?? post.pubDate ?? '');\n  const publishedAt = Number.isNaN(published.valueOf()) ? null : published.toISOString();\n  const publishedInBrisbane = publishedAt ? formatInBrisbane(published) : null;\n\n  return [{\n    json: {\n      post_id: postId,\n      title,\n      summary,\n      post_url: postUrl,\n      published_at: publishedAt,\n      first_seen_at: new Date().toISOString(),\n      message: [\n        '🏦 **New Up blog post**',\n        '',\n        `**${escapeMarkdown(title)}**`,\n        publishedInBrisbane ? `Published: ${publishedInBrisbane}` : null,\n        '',\n        summary,\n        '',\n        `[Read the full article](${postUrl})`,\n      ].filter((line) => line !== null).join('\\n'),\n      matrix_request_id: requestIdFor(postId),\n    },\n  }];\n});"
      },
