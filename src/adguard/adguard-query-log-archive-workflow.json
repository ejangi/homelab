              "responseFormat": "json"
            }
          },
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "older_than",
                    "value": "={{ $pageCount === 0 ? '' : $response.body.oldest }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !Array.isArray($response.body.data) || $response.body.data.length === 0 || !$response.body.oldest || Date.parse($response.body.oldest) <= Date.parse($('Collection window').first().json.since) }}",
              "limitPagesFetched": true,
              "maxRequests": 200,
              "requestInterval": 100
            }
          }
        }
